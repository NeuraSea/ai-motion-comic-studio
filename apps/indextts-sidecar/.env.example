INDEXTTS_API_TOKEN=replace-with-a-long-random-token
INDEXTTS_MODEL_NAME=IndexTTS-2
INDEXTTS_BACKEND=mlx
INDEXTTS_MODEL_DIR=./models/mlx-indextts2-standard-8bit
INDEXTTS_HF_REPOSITORY=vanch007/mlx-indextts2-standard-8bit
INDEXTTS_HF_REVISION=81e890787be1b0b174b9ec3dafd89642f578b286
INDEXTTS_VOICE_DIR=./voices
INDEXTTS_VOICE_MANIFEST=./voices/voices.json
INDEXTTS_SPEAKER_CACHE_DIR=./speaker-cache
INDEXTTS_AUTO_PRECOMPUTE_SPEAKERS=1
INDEXTTS_MLX_MEMORY_LIMIT_GB=12
INDEXTTS_MLX_DEVICE=mps
INDEXTTS_MLX_DIFFUSION_STEPS=16
INDEXTTS_MLX_CFG_RATE=0.7
# Leave empty for pre-quantized 8-bit weights; set 4 or 8 only for runtime quantization.
INDEXTTS_MLX_QUANTIZE_BITS=
INDEXTTS_MAX_TEXT_CHARACTERS=4096
INDEXTTS_FP16=1
INDEXTTS_DEEPSPEED=0
INDEXTTS_CUDA_KERNEL=0
INDEXTTS_FFMPEG=ffmpeg
