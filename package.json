{
  "name": "manju-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/opencut-editor"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/dev.ts",
    "dev:web": "vite",
    "start:api": "tsx server/dev.ts",
    "start:indextts": "cd apps/indextts-sidecar && ./scripts/start.sh",
    "start": "SERVE_WEB=1 PORT=5173 node dist-server/index.cjs",
    "start:release": "MANJU_FFMPEG_RELEASE_MODE=1 SERVE_WEB=1 PORT=5173 node dist-server/index.cjs",
    "server:start": "node scripts/local-server-manager.mjs start",
    "server:ensure": "node scripts/local-server-manager.mjs ensure",
    "server:status": "node scripts/local-server-manager.mjs status",
    "server:restart": "node scripts/local-server-manager.mjs restart",
    "server:stop": "node scripts/local-server-manager.mjs stop",
    "build": "tsc -b && vite build && npm run build:server && npm run build:licenses",
    "build:release": "npm run build && npm run verify:ffmpeg:release -- --receipt dist/legal/FFmpeg/VERIFICATION_RECEIPT.json",
    "build:server": "esbuild server/standalone.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs",
    "build:licenses": "node scripts/archive-opencut-licenses.mjs",
    "preview": "vite preview",
    "test": "npm run test:server-manager && npm run test:server && npm run test:audio-first-verifier && npm run test:seedance-golden-verifier && npm run test:ffmpeg-distribution && npm run test:client && npm run test:opencut",
    "test:server-manager": "node --test scripts/local-server-manager.test.mjs",
    "test:server": "tsx --test server/*.test.ts server/providers/*.test.ts",
    "test:client": "tsx --test tests/*.test.ts",
    "test:opencut": "npm --workspace @manju/opencut-editor run verify",
    "test:audio-first-verifier": "tsx --test scripts/verify-audio-first-copy.test.ts",
    "test:seedance-golden-verifier": "tsx --test scripts/verify-seedance-golden.test.ts scripts/prepare-seedance-golden.test.ts",
    "prepare:seedance-golden": "tsx scripts/prepare-seedance-golden.ts",
    "finalize:seedance-golden": "tsx scripts/finalize-seedance-golden.ts",
    "verify:seedance-golden": "tsx scripts/verify-seedance-golden.ts",
    "test:ffmpeg-distribution": "tsx --test scripts/verify-ffmpeg-distribution.test.ts",
    "verify:ffmpeg:release": "tsx scripts/verify-ffmpeg-distribution.ts --release",
    "test:e2e:offline": "npm run build && python3 e2e/offline-browser.py",
    "test:e2e:audio-first": "npm run build && python3 e2e/audio-first-browser.py",
    "test:e2e:offline:faults": "npm run build && python3 e2e/offline-browser-faults.py",
    "test:e2e:recovery": "npm run build && python3 e2e/recovery-browser.py",
    "test:e2e:per-shot-visual": "npm run build && python3 e2e/per-shot-visual-analysis-browser.py",
    "test:e2e:performance-spike": "npm run build && python3 e2e/browser-performance-spike.py",
    "test:e2e:dual-encoder": "python3 e2e/dual-encoder-file-acceptance.py"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@manju/opencut-editor": "0.1.0",
    "express": "^5.2.1",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "latest",
    "mediabunny": "1.29.1",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "latest",
    "vite": "latest"
  }
}
