# 漫剧 API 服务（默认只监听本机）
HOST=127.0.0.1
PORT=8788

# Codex Tools OpenAI 兼容反代
CODEX_TOOLS_BASE_URL=http://127.0.0.1:8787
CODEX_TOOLS_IMAGE_MODEL=gpt-image-2

# 可选：优先从环境变量取 key。未设置时，会读取 macOS Codex Tools key 文件。
# CODEX_TOOLS_API_KEY=
# CODEX_TOOLS_API_KEY_FILE=/absolute/path/to/api-proxy.key

# 可选：图片生成超时，毫秒。默认 600000。
# IMAGE_GENERATION_TIMEOUT_MS=600000
# MAX_QUEUE_DEPTH=100
# MANJU_RUNTIME_DIR=runtime

# FFmpeg 发行边界：本机开发默认使用 ffmpeg-static（不可进入安装包）。
# 发行构建必须同时提供绝对路径和同目标平台的审计清单，然后执行 npm run build:release。
# MANJU_FFMPEG_PATH=/absolute/path/to/audited/ffmpeg
# MANJU_FFPROBE_PATH=/absolute/path/to/audited/ffprobe
# MANJU_FFMPEG_MANIFEST=/absolute/path/to/FFMPEG_DISTRIBUTION.json
# MANJU_FFMPEG_RECEIPT=/absolute/path/to/VERIFICATION_RECEIPT.json
# MANJU_FFMPEG_RELEASE_MODE=1
